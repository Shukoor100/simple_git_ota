# --- Flash / partitions (two OTA slots) ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- Roll back automatically if a new image never confirms itself ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- HTTPS server verification using the Mozilla CA bundle ---
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- Your site. CI overwrites this line automatically; set it for your first USB flash. ---
CONFIG_OTA_BASE_URL="https://Shukoor100.github.io/simple_git_ota"
